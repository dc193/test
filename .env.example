# Telegram Bot Token (从 @BotFather 获取)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google AI API Key (从 https://aistudio.google.com/apikey 获取)
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# Obsidian Vault 路径 (你的 Obsidian 笔记文件夹)
OBSIDIAN_VAULT_PATH=/Users/your_username/Documents/Obsidian/YourVault

# 授权的 Telegram 用户 ID (可选，留空则任何人可用)
# 获取方式：启动 bot 后发送 /myid 命令
ALLOWED_USER_IDS=
