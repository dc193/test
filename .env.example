# Telegram Bot Token (从 @BotFather 获取)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# AI 提供商配置
# 可选: gemini, openai, claude, grok, local
AI_PROVIDER=gemini

# AI 模型名称 (可选，不填则使用默认)
# Gemini 默认: gemini-2.5-flash
# OpenAI 默认: gpt-4o-mini
# Claude 默认: claude-sonnet-4-20250514
# Grok 默认: grok-2-latest
# Local 默认: qwen2.5:7b
AI_MODEL=

# Google Gemini API Key (AI_PROVIDER=gemini 时必填)
# 获取地址: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# OpenAI API Key (AI_PROVIDER=openai 时必填)
# 获取地址: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API Key (AI_PROVIDER=claude 时必填)
# 获取地址: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# xAI Grok API Key (AI_PROVIDER=grok 时必填)
# 获取地址: https://console.x.ai/
XAI_API_KEY=your_xai_api_key_here

# 本地模型配置 (AI_PROVIDER=local 时使用)
# Ollama 默认: http://localhost:11434/v1
# LM Studio 默认: http://localhost:1234/v1
LOCAL_API_BASE=http://localhost:11434/v1
LOCAL_API_KEY=not-needed

# Obsidian Vault 路径 (你的 Obsidian 笔记文件夹)
OBSIDIAN_VAULT_PATH=/Users/your_username/Documents/Obsidian/YourVault

# 授权的 Telegram 用户 ID (可选，留空则任何人可用)
# 获取方式：启动 bot 后发送 /myid 命令
ALLOWED_USER_IDS=
