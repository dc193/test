{
  "manifest_version": 3,
  "name": "Video Speech to Text",
  "version": "1.0.0",
  "description": "录制视频语音并转换为文字保存",
  "permissions": [
    "activeTab",
    "tabCapture",
    "downloads"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
